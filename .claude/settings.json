{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.local)",
      "Read(./apps/*/.env.*.local)",
      "Read(./apps/*/.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./apps/*/.env)",
      "Edit(./apps/*/.env.local)",
      "Edit(./apps/*/.env.*.local)",
      "Edit(./apps/*/.env.production)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.*.local)",
      "Write(./.env.production)",
      "Write(./apps/*/.env)",
      "Write(./apps/*/.env.local)",
      "Write(./apps/*/.env.*.local)",
      "Write(./apps/*/.env.production)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git clean *)"
    ]
  }
}

# Port the API listens on. Defaults to 3001 when unset.
PORT=3001

# PostgreSQL connection string. Required: the API does not start without it.
# These are placeholder credentials for the local database in compose.yaml
# (pnpm db:up), not a secret.
DATABASE_URL=postgresql://ielts_prep:ielts_prep@localhost:5432/ielts_prep
